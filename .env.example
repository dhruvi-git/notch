# Copy to .env (never commit it). Only needed for the "cloud" profile;
# the "local" profile works with docker compose and built-in development defaults.

SPRING_PROFILES_ACTIVE=cloud

# Neon: use the JDBC form of the connection string, with user and password separate.
DATABASE_URL=jdbc:postgresql://<your-neon-host>/notch?sslmode=require
DATABASE_USER=<user>
DATABASE_PASSWORD=<password>

# 32 random bytes, base64. Generate with: openssl rand -base64 32
NOTCH_CRYPTO_KEY=<base64-key>

# Frontend origins allowed to call the API, comma-separated.
NOTCH_CORS_ORIGINS=https://your-app.vercel.app
